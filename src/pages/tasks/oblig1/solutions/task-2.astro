---
import Button from "@/components/ui/Button.astro";
import Heading from "@/components/ui/Heading.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Task1 from "./task-1.astro";
import TaskCard from "@/components/ui/taskCard.astro";

const task2 = await getCollection("tasks", ({ data }) =>
  data.title.includes("Task 2"),
);

const { Content } = await render(task2[0]);
---

<Layout
  title="Task 2 solution | Martine Evensen"
  description="Solution for task 2 in oblig 1"
>
  <div
    class="py-34 flex flex-col gap-12 items-center justify-center w-full px-8"
  >
    <div class="content">
      <Content />
    </div>
    <TaskCard
      class:list={"w-full max-w-5xl bg-secondary/10 gap-4 flex flex-col "}
    >
      <div class="grid grid-cols-2 gap-2">
        <p>Is the sky blue?</p>
        <div class="flex gap-4">
          <Button data-answer="true" class="answer-button">True</Button>
          <Button data-answer="false" class="answer-button">False</Button>
          <p class="feedback"></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <p>Is 2 + 2 equal to 5?</p>
        <div class="flex gap-4">
          <Button data-answer="false" class="answer-button">True</Button>
          <Button data-answer="true" class="answer-button">False</Button>
          <p class="feedback"></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <p>Is water wet?</p>
        <div class="flex gap-4">
          <Button data-answer="true" class="answer-button">True</Button>
          <Button data-answer="false" class="answer-button">False</Button>
          <p class="feedback"></p>
        </div>
      </div>
    </TaskCard>

    <script></script>
  </div>

  <script>
    const answerButtons = document.querySelectorAll(
      ".answer-button",
    ) as NodeListOf<HTMLButtonElement>;

    answerButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const questionDiv = button.closest("div") as HTMLDivElement;
        const feedback = questionDiv.querySelector(
          ".feedback",
        ) as HTMLParagraphElement;
        const correctAnswer = button.dataset.answer === "true";

        if (correctAnswer) {
          feedback.innerHTML = "Riktig";
          feedback.classList.remove("text-red-500");
          feedback.classList.add("text-green-500");
          button.classList.add("text-green-500");
          button.classList.add("border-green-500");
        } else {
          feedback.innerHTML = "Galt";
          feedback.classList.remove("text-green-500");
          feedback.classList.add("text-red-500");
          button.classList.add("text-red-500");
          button.classList.add("border-red-500");
        }

        //   Disable both buttons for the question
        const buttons = questionDiv.querySelectorAll(
          ".answer-button",
        ) as NodeListOf<HTMLButtonElement>;
        buttons.forEach((btn) => {
          btn.disabled = true;
          btn.classList.add("opacity-50", "cursor-not-allowed");
        });
      });
    });
  </script>
</Layout>
