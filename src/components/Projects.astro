---
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import Link from "./ui/Link.astro";
import assignmentThumb from "@/assets/project-thumbnails/assignmentThumb.png";

type Props = {
  limit?: number;
};

const projects = await getCollection("projects");

const mandatoryAssignment = {
  id: 1,
  project: {
    data: {
      title: "Oblig 1",
      description: "Mandatory assignments",
      image: { src: assignmentThumb.src },
      href: "/tasks/oblig1/",
      assignment: true,
    },
  },
};

const { limit } = Astro.props;
---

<div
  class="h-full w-full grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(380px,1fr))] gap-6 justify-center justify-items-center px-8"
>
  {
    projects
      .slice(0, limit)
      .map((project) => <ProjectCard key={project.id} project={project} />)
  }

  <ProjectCard
    key={mandatoryAssignment.id}
    project={mandatoryAssignment.project}
  />
  <div>
    {
      limit && (
        <Link href="/projects" icon="arrow_forward" iconPosition="right">
          View all projects
        </Link>
      )
    }
  </div>
</div>
